<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_excel_upload_wizard" model="ir.ui.view">
        <field name="name">fawtara.excel.upload.form</field>
        <field name="model">fawtara.excel.upload</field>
        <field name="arch" type="xml">
            <form string="Bulk Invoice Upload">
                <sheet>
                    <!-- Upload form -->
                    <group invisible="state == 'result'">
                        <group string="Upload Settings">
                            <field name="client_id"/>
                            <field name="environment"/>
                            <field name="excel_file"
                                   widget="binary"
                                   filename="excel_filename"/>
                            <field name="excel_filename" invisible="1"/>
                        </group>
                        <div class="alert alert-info" role="alert">
                            <strong>Excel Template:</strong>
                            Download the template below, fill it in, then upload here.
                            <br/>
                            Columns: Invoice Number | Type | Transaction | Date | Currency |
                            Buyer Name | Buyer VATIN | Buyer City | Contract Ref |
                            Item Name | Qty | Unit | Price | VAT Cat | VAT Rate |
                            Service Code | ISIC | Preceding Invoice # | Preceding UUID
                            <br/>
                            <br/>
                            <a href="/fawtara/download/invoice-template"
                               class="btn btn-sm btn-primary"
                               target="_blank">
                                <i class="fa fa-download"/>
                                Download Excel Template
                            </a>
                        </div>
                    </group>

                    <!-- Results -->
                    <group invisible="state != 'result'">
                        <div class="alert alert-success" role="alert">
                            <h4>Upload Complete</h4>
                        </div>
                        <group string="Summary">
                            <field name="total_rows" readonly="1"/>
                            <field name="accepted" readonly="1"/>
                            <field name="rejected" readonly="1"/>
                        </group>
                        <group string="Details">
                            <field name="result_details"
                                   nolabel="1"
                                   readonly="1"/>
                        </group>
                    </group>

                    <field name="state" invisible="1"/>
                </sheet>
                <footer>
                    <button name="action_upload"
                            string="Upload and Submit"
                            type="object"
                            class="btn-primary"
                            invisible="state == 'result'"/>
                    <button name="action_close"
                            string="Close"
                            type="object"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_excel_upload" model="ir.actions.act_window">
        <field name="name">Bulk Upload (Excel)</field>
        <field name="res_model">fawtara.excel.upload</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>