<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Invoice Form -->
    <record id="view_portal_invoice_form" model="ir.ui.view">
        <field name="name">fawtara.portal.invoice.form</field>
        <field name="model">fawtara.portal.invoice</field>
        <field name="arch" type="xml">
            <form string="Submit Invoice">
                <header>
                    <button name="action_submit"
                            string="Submit to OTA"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_reverse"
                            string="Reverse (Credit Note)"
                            type="object"
                            class="btn-warning"
                            invisible="state != 'cleared'"/>
                    <button name="action_refresh_status"
                            string="Refresh Status"
                            type="object"
                            invisible="state == 'draft'"/>
                    <button name="action_reset_draft"
                            string="Reset to Draft"
                            type="object"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,queued,cleared"/>
                </header>
                <sheet>

                    <!-- Smart buttons -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_reversals"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-undo"
                                invisible="reversal_count == 0">
                            <field name="reversal_count"
                                   widget="statinfo"
                                   string="Credit Notes"/>
                        </button>
                        <button name="action_download_pdf"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-file-pdf-o"
                                invisible="state != 'cleared'">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Download PDF</span>
                            </div>
                        </button>
                        <button name="action_download_qr"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-qrcode"
                                invisible="state != 'cleared'">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Download QR</span>
                            </div>
                        </button>
                    </div>

                    <!-- Reversal info -->
                    <div class="alert alert-info"
                         invisible="not reversed_invoice_id">
                        🔁 This is a credit note for invoice:
                        <field name="reversed_invoice_id" readonly="1"/>
                    </div>

                    <!-- Sandbox warning -->
                    <div class="alert alert-warning"
                         invisible="environment != 'SANDBOX'">
                        🟡 <strong>SANDBOX MODE</strong> — Testbed only, no real tax reporting.
                    </div>

                    <!-- Cleared banner with QR -->
                    <div class="alert alert-success"
                         invisible="state != 'cleared'">
                        <div class="row align-items-center">
                            <div class="col-md-8">
                                ✅
                                <strong>Cleared by OTA</strong>
                                <br/>
                                UUID:
                                <field name="invoice_uuid" readonly="1"/>
                                <br/>
                                Clearance ID:
                                <field name="clearance_id" readonly="1"/>
                            </div>
                            <div class="col-md-4 text-end"
                                 invisible="not qr_image_base64">
                                <div style="display:inline-block;background:white;padding:8px;border-radius:8px;border:1px solid #d1fae5;">
                                    <field name="qr_image_base64"
                                           widget="image"
                                           style="width:100px;height:100px;"/>
                                    <p style="margin:4px 0 0;font-size:0.68rem;color:#065f46;text-align:center;">
                                        Scan to verify
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Failed banner -->
                    <div class="alert alert-danger"
                         invisible="state != 'failed'">
                        ❌ Failed:
                        <field name="submission_error" readonly="1"/>
                    </div>

                    <div class="alert alert-warning"
                         invisible="environment != 'SANDBOX'">
                        🟡 <strong>SANDBOX MODE</strong> — This invoice will be sent
                        to the testbed. No real tax reporting will occur.
                    </div>

                    <group>
                        <group string="Invoice Header">
                            <field name="client_id"
                                   invisible="state != 'draft'"/>
                            <field name="environment" widget="radio"
                                   invisible="state != 'draft'"/>
                            <field name="invoice_number"/>
                            <field name="invoice_type_code"/>
                            <field name="transaction_type"/>
                            <field name="issue_date"/>
                            <field name="issue_time"/>
                            <field name="currency_code"/>
                        </group>
                        <group string="References">
                            <field name="contract_reference"/>
                            <field name="purchase_order_reference"/>
                            <field name="invoice_note"/>
                        </group>
                    </group>

                    <!-- Credit note fields -->
                    <group string="Original Invoice"
                           invisible="invoice_type_code not in ['381','261']">
                        <field name="preceding_invoice_number"/>
                        <field name="preceding_invoice_date"/>
                        <field name="preceding_invoice_uuid"/>
                        <field name="credit_note_reason"/>
                    </group>

                    <group>
                        <group string="Seller">
                            <field name="seller_name"/>
                            <field name="seller_vatin"/>
                            <field name="seller_address_line1"/>
                            <field name="seller_address_line2"/>
                            <field name="seller_address_line3"/>
                            <field name="seller_city"/>
                            <field name="seller_post_code"/>
                            <field name="seller_country_code"/>
                            <field name="seller_contact_phone"/>
                            <field name="seller_contact_email"/>
                        </group>
                        <group string="Buyer">
                            <field name="buyer_name"/>
                            <field name="buyer_vatin"/>
                            <field name="buyer_address_line1"/>
                            <field name="buyer_address_line2"/>
                            <field name="buyer_address_line3"/>
                            <field name="buyer_city"/>
                            <field name="buyer_post_code"/>
                            <field name="buyer_country_code"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Invoice Lines">
                            <field name="line_ids"
                                   readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="item_name"/>
                                    <field name="quantity"/>
                                    <field name="unit_code"/>
                                    <field name="unit_price"/>
                                    <field name="vat_category_code"/>
                                    <field name="vat_rate"/>
                                    <field name="line_total"/>
                                    <field name="vat_amount"/>
                                    <field name="line_total_incl"/>
                                    <field name="service_type_code" optional="hide"/>
                                    <field name="isic_code" optional="hide"/>
                                </list>
                            </field>
                        </page>
                    </notebook>

                    <group class="oe_subtotal_footer">
                        <field name="total_excl_tax"/>
                        <field name="total_tax"/>
                        <field name="total_incl_tax"
                               class="oe_subtotal_footer_separator"/>
                    </group>

                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Invoice List -->
    <record id="view_portal_invoice_list" model="ir.ui.view">
        <field name="name">fawtara.portal.invoice.list</field>
        <field name="model">fawtara.portal.invoice</field>
        <field name="arch" type="xml">
            <list string="My Invoices"
                  decoration-success="state == 'cleared'"
                  decoration-danger="state == 'failed'"
                  decoration-warning="state == 'queued'"
                  decoration-muted="state == 'draft'">
                <field name="invoice_number"/>
                <field name="client_id"/>
                <field name="invoice_type_code"/>
                <field name="transaction_type"/>
                <field name="issue_date"/>
                <field name="buyer_name"/>
                <field name="total_excl_tax"/>
                <field name="total_tax"/>
                <field name="total_incl_tax"/>
                <field name="state"/>
                <field name="invoice_uuid"/>
                <field name="reversal_count"/>
            </list>
        </field>
    </record>

